  "alerts": [
    {
      "id": "urn:oid:2.49.0.1.840.0.59599f54f3e9e47644ed14ad1fd6294e24114766.001.1",
      "event": "Flood Watch",
      "severity": "Severe",
      "urgency": "Future",
      "certainty": "Possible",
      "headline": "Flood Watch issued September 22 at 2:48PM HST until September 26 at 6:00PM HST by NWS Honolulu HI",
      "description": "A potential tropical cyclone is expected to bring heavy rain to the\neastern end of the state over the coming days. The track of this\npotential storm is uncertain, but heavry rain is likely.\n\n* WHAT...Flash flooding caused by excessive rainfall is possible.\n\n* WHERE...Maui, Lanai, Molokai, The Big Island and Kahoolawe.\n\n* WHEN...From Wednesday afternoon through Saturday afternoon.\n\n* IMPACTS...Flood prone roads and other low lying areas may be closed\ndue to elevated runoff and overflowing streams. Urban areas may\nreceive more significant flooding and property damage due to rapid\nrunoff.\n\n* ADDITIONAL DETAILS...\n- Heavy rain on the north side of a developing tropical system (the\nfuture Nolo) should develop Wednesday afternoon. Windward and\nsoutheast Big Island and windward Maui are the most likely to\nexperience heavy rain. However, other islands in Maui County are\nat risk as well, and therefore are included in the watch. Very\nhigh rainfall rates, which can cause flash flooding, are possible\nwithin the entire watch area.",
      "instruction": "You should monitor later forecasts and be prepared to take action\nshould Flash Flood Warnings be issued.",
      "areaDesc": "Lanai Mauka; Kahoolawe; Maui Windward West; Maui Leeward West; Haleakala Summit; Kona; Kohala; Big Island Interior; Big Island Summit; Molokai Windward; Molokai Southeast; Molokai North; Molokai West; Molokai Leeward South; Lanai Windward; Lanai Leeward; Lanai South; Maui Central Valley North; Maui Central Valley South; Windward Haleakala; Kipahulu; South Maui/Upcountry; South Haleakala; Big Island South; Big Island Southeast; Big Island East; Big Island North",
