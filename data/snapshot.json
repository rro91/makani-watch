  "alerts": [
    {
      "id": "urn:oid:2.49.0.1.840.0.79bb37e9871028ad1701b82f08743ce4f485a1c4.001.1",
      "event": "Flash Flood Warning",
      "severity": "Severe",
      "urgency": "Immediate",
      "certainty": "Likely",
      "headline": "Flash Flood Warning issued October 29 at 8:55AM HST until October 29 at 11:45AM HST by NWS Honolulu HI",
      "description": "FFWHFO\n\nThe National Weather Service in Honolulu has issued a\n\n* Flash Flood Warning for...\nThe island of Maui in Maui County\n\n* Until 1145 AM HST.\n\n* At 855 AM HST, Doppler radar indicated heavy rain over windward and\nsoutheast Maui. Rain was falling at a rate of 1 to 2 inches per\nhour and has been nearly stationary along the eastern flank of\nHaleakala. Stream such as Oheo Gulch has been steadily rising and\nflash flooding is ongoing or expected to begin shortly.\n\nHAZARD...Flash flooding caused by heavy rain.\n\nSOURCE...Radar indicated.\n\nIMPACT...Flash flooding of small creeks and streams, urban areas,\nhighways, streets and underpasses as well as other poor\ndrainage and low-lying areas.\n\n* Some locations that will experience flash flooding include...\nKeanae, Nahiku, Kipahulu, Kaupo, Huelo, Makawao, Hana, Pukalani,\nHaiku-Pauwela and Haliimaile.",
      "instruction": "Turn around, don't drown when encountering flooded roads. Most flood\ndeaths occur in vehicles.\n\nBe aware of your surroundings and do not drive on flooded roads.",
      "areaDesc": "Maui, HI",
      "zones": [],
      "effective": "2026-10-29T08:55:00-10:00",
      "expires": "2026-10-29T11:45:00-10:00",
      "senderName": "NWS Honolulu HI",
      "sourceUrl": "https://api.weather.gov/alerts/urn%3Aoid%3A2.49.0.1.840.0.79bb37e9871028ad1701b82f08743ce4f485a1c4.001.1"
    },
    {
      "id": "urn:oid:2.49.0.1.840.0.3976a27a9c18de5086ccb20f64b3bf3ba81e3650.002.1",
      "event": "Flood Watch",
      "severity": "Severe",
      "urgency": "Future",
      "certainty": "Possible",
      "headline": "Flood Watch issued October 29 at 3:45AM HST until October 29 at 6:00PM HST by NWS Honolulu HI",
      "description": "A trough over the eastern half of the state will continue to focus\nreturn showers to the islands through the day. Pockets of heavy rain\nand isolated thunderstorms may produce flash flooding over Maui and\nHawaii Counties.\n\n* WHAT...Flash flooding caused by excessive rainfall continues to be\npossible.\n\n* WHERE...Molokai, Lanai, Maui, Kahoolawe and Big Island.\n\n* WHEN...Through this afternoon.\n\n* IMPACTS...Flood prone roads and other low lying areas may be closed\ndue to elevated runoff and overflowing streams. Urban areas may\nreceive more significant flooding and property damage due to rapid\nrunoff.\n\n* ADDITIONAL DETAILS...\n- A trough continues to lay over the eastern half of the state\nwithin a very moist and fairly unstable environment. Energy\nmoving up from the southwest may initiate return periods of\nmoderate to locally heavy rainfall. This rain has a high\nprobability of focusing on Maui and Hawaii Counties. Locally\nmoderate to heavy showers, with possible isolated thunderstorms,\nmay produce short-lived intense rain rates through the day.",
      "instruction": "You should monitor later forecasts and be prepared to take action\nshould Flash Flood Warnings be issued.",
      "areaDesc": "Lanai Mauka; Kahoolawe; Maui Windward West; Maui Leeward West; Haleakala Summit; Kona; Kohala; Big Island Interior; Big Island Summit; Molokai Windward; Molokai Southeast; Molokai North; Molokai West; Molokai Leeward South; Lanai Windward; Lanai Leeward; Lanai South; Maui Central Valley North; Maui Central Valley South; Windward Haleakala; Kipahulu; South Maui/Upcountry; South Haleakala; Big Island South; Big Island Southeast; Big Island East; Big Island North",
