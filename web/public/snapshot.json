  "alerts": [
    {
      "id": "urn:oid:2.49.0.1.840.0.0e2b6a9e0b5751903ff2e2982181acae7f3226f0.001.1",
      "event": "Flood Watch",
      "severity": "Severe",
      "urgency": "Future",
      "certainty": "Possible",
      "headline": "Flood Watch issued September 16 at 4:03PM HST until September 18 at 6:00AM HST by NWS Honolulu HI",
      "description": "Remnant moisture from former Tropical Storm Norbert will bring\nperiods of moderate to heavy showers to the Hawaiian Islands tonight\nthrough Friday morning.\n\n* WHAT...Flash flooding caused by excessive rainfall is possible.\n\n* WHERE...All main Hawaiian Islands.\n\n* WHEN...Through late Thursday night.\n\n* IMPACTS...Flood prone roads and other low lying areas may be closed\ndue to elevated runoff and overflowing streams. Urban areas may\nreceive more significant flooding and property damage due to rapid\nrunoff.\n\n* ADDITIONAL DETAILS...\n- A band of remnant moisture from Norbert will move east across the\nislands tonight into Friday, bringing moderate to locally heavy\nshowers. There is a slight chance of thunderstorms on Thursday as\nwell, which could produce briefly higher rain rates, increasing\nthe risk of flash flooding.",
      "instruction": "You should monitor later forecasts and be prepared to take action\nshould Flash Flood Warnings be issued.",
      "areaDesc": "Niihau; Kauai Southwest; Kauai Mountains; Waianae Coast; Oahu North Shore; Olomana; Central Oahu; Waianae Mountains; Lanai Mauka; Kahoolawe; Maui Windward West; Maui Leeward West; Haleakala Summit; Kona; Kohala; Big Island Interior; Big Island Summit; Kauai North; Kauai East; Kauai South; East Honolulu; Honolulu Metro; Ewa Plain; Koolau Windward; Koolau Leeward; Molokai Windward; Molokai Southeast; Molokai North; Molokai West; Molokai Leeward South; Lanai Windward; Lanai Leeward; Lanai South; Maui Central Valley North; Maui Central Valley South; Windward Haleakala; Kipahulu; South Maui/Upcountry; South Haleakala; Big Island South; Big Island Southeast; Big Island East; Big Island North",
